msgid "なんだ？"
msgstr "¿Qué pasa?"

#. y4:line_status=todo
#. y4:msg_type=subtitle
#. kurohyou:source_csv=scaleform/ca09_03/ca09_03.csv
#. kurohyou:row=3
#. kurohyou:frames=458,505
msgctxt "kurohyou-scaleform|ca09_03|row=3|frames=458,505"
msgid "戸田の愛人か…"
msgstr "La amante de Toda..."

#. y4:line_status=todo
#. y4:msg_type=subtitle
#. kurohyou:source_csv=scaleform/ca09_03/ca09_03.csv
#. kurohyou:row=4
#. kurohyou:frames=505,605
msgctxt "kurohyou-scaleform|ca09_03|row=4|frames=505,605"
msgid "水商売の女って感じだな"
msgstr "Parece una mujer del mundo nocturno."

#. y4:line_status=todo
#. y4:msg_type=subtitle
#. kurohyou:source_csv=scaleform/ca09_03/ca09_03.csv
#. kurohyou:row=5
#. kurohyou:frames=605,711
msgctxt "kurohyou-scaleform|ca09_03|row=5|frames=605,711"
msgid "でも ワザワザこんなところに,挟んであるってのも怪しいな"
msgstr "Aunque que la hayan puesto aquí a propósito...\nparece bastante sospechoso."

#. y4:line_status=todo
#. y4:msg_type=subtitle
#. kurohyou:source_csv=scaleform/ca09_03/ca09_03.csv
#. kurohyou:row=6
#. kurohyou:frames=711,751
msgctxt "kurohyou-scaleform|ca09_03|row=6|frames=711,751"
msgid "とりあえず頂いとくか"
msgstr "Por ahora me la quedo."

#. y4:line_status=todo
#. y4:msg_type=subtitle
#. kurohyou:source_csv=scaleform/ca09_03/ca09_03.csv
#. kurohyou:row=7
#. kurohyou:frames=814,904
msgctxt "kurohyou-scaleform|ca09_03|row=7|frames=814,904"
msgid "この女の名前が,『アン』だったりして…"
msgstr "¿Y si el nombre de esta mujer\nfuera \"An\"...?"

#. y4:line_status=todo
#. y4:msg_type=subtitle
#. kurohyou:source_csv=scaleform/ca09_03/ca09_03.csv
#. kurohyou:row=8
#. kurohyou:frames=904,976
msgctxt "kurohyou-scaleform|ca09_03|row=8|frames=904,976"
msgid "そんなに都合良く,いかねぇな…"
msgstr "No puede ser tan conveniente..."

#. y4:line_status=todo
#. y4:msg_type=subtitle
#. kurohyou:source_csv=scaleform/ca09_03/ca09_03.csv
#. kurohyou:row=9
#. kurohyou:frames=976,1052
msgctxt "kurohyou-scaleform|ca09_03|row=9|frames=976,1052"
msgid "でも 大事な手がかりだ"
msgstr "Aun así, es una pista importante."

#. y4:line_status=todo

#. kurohyou:text_offset=0x409C8
msgctxt "kurohyou|globals|stja|hash=498EB365"
msgid "お見事!!\nこれで【ムエタイエルボー】はお主のものだ\n敵の顔面を斬って斬って切り裂くがよい!!"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF

msgctxt "kurohyou|globals|stja|hash=499B876B"
msgid "敵の頭を壁に押しつけ間髪入れずに後頭部にヒジを見舞う連携撃"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text

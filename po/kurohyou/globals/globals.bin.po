#. kurohyou:text_offset=0x4095C
msgctxt "kurohyou|globals|stja|hash=498EB364"
msgid "お見事!!\nこれで【ナックルブロー】はお主のものだ\n人間などゴムまりのように吹き飛ばすがよい!!"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF

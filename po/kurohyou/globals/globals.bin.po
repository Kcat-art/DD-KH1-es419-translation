#. kurohyou:text_offset=0x2DAAE
msgctxt "kurohyou|globals|stja|hash=190D9D90"
msgid "優\nてじーだよん\n龍也くん\n今日も色んなお話し出来て\n嬉しかったな　(^○^)/\n\n龍也くんて何か\n年下って感じしないよね\n私もしっかりしないとっ\n\nじゃあ\n今日はこの辺で\n\nおやすみなさい\n♪ てじー♪"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=190D9D91
#. kurohyou:text_offset=0x2D978
msgctxt "kurohyou|globals|stja|hash=190D9D91"
msgid "優\nこんばんは\n龍也くん\nもうお家についたかな？\n\n時間も遅いから\nフラフラしてちゃダメだよ\n\nそれにしても\n龍也くんて不思議な魅力が\nあるよね～　(＞▽＜)\n\n人を惹き付けるって言うか\n上手く言えないけど\nわかる？\n\n優は龍也くんに\n夢中になっちゃうかも\nエヘ(*･･*)\n\nじゃあ\nまたね\n\n♪ てじー♪"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=190D9D92
#. kurohyou:text_offset=0x2D8D6
msgctxt "kurohyou|globals|stja|hash=190D9D92"
msgid "優\n優です\n龍也くん\n今日は楽しかったね～\nd(＞_＜ )\n\n何かあっという間で\nビックリ\n\nまた会いに来てくれたら\nうれしいな\n\nそれじゃあね\n\n♪ てじー♪"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=190D9D95
#. kurohyou:text_offset=0x2DD46
msgctxt "kurohyou|globals|stja|hash=190D9D95"
msgid "優\n龍也くん大好き\n私の大好きな龍也くん\n今日も盛り上がったね\n\nなんか龍也くんと話してると\n仕事を忘れちゃうんだよな～\n不思議\nもしかして愛の力？\nドキドキ\nq(≧∇≦*)(*≧∇≦)p\n\nじゃあ\nまたね\nおやすみなさい\n\n♪ てじー♪"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=190D9D96
#. kurohyou:text_offset=0x2DC62
msgctxt "kurohyou|globals|stja|hash=190D9D96"
msgid "優\n話足りないよ～\n今日もあっという間で\nもっと話していたかったな～\n時間て残酷ね\no(；△；)o\n\nでも\nまたすぐ会えるよね？\nって言うか会いたいよ～\n\n龍也くん\nまた会いにきてね\n\nじゃあ\nおやすみなさ～い\n\n♪ てじー♪"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=190D9D97
#. kurohyou:text_offset=0x2DB7C
msgctxt "kurohyou|globals|stja|hash=190D9D97"
msgid "優\nてじーで～す\n今日も優は龍也くんから\n元気をいっぱいもらっちゃっ\nたo(*^▽^*)o~♪\n\n優は龍也くんに\n何にも出来ないけど\nちょっとでも癒されてもらえ\nたら嬉しいなっ\n\nでは！\nおやすみ\n愛しの龍也くん\n\n♪ てじー♪"
msgstr ""


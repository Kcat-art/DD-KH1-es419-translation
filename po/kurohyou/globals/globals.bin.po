msgctxt "kurohyou|globals|stja|hash=1949EE40"
msgid "沙耶\nテンション\nたっちゃんゎもうぉ家に着い\nたかな？\n\nさーやゎこれから夜の\n神室町を探検してくるよ！\n\n新発見あったら報告\nするね！\n\nでゎ！\nアデュ～！"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF

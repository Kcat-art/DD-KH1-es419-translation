#. kurohyou:text_offset=0x2D2A8
msgctxt "kurohyou|globals|stja|hash=AABA643B"
msgid "優\nてじーだよ\n龍也く～ん\n今日は遊びに来てくれて\nありがとっ\n\nとっても楽しかったよ\n\n龍也くんみたいな子と\nトークするのも久しぶりで\n何か新鮮って感じ\n\nまた遊びにきてね～\n(*￣▽￣)ﾉ~~ \n\nそれじゃ\n\n♪ てじー♪"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text

msgctxt "kurohyou|globals|stja|hash=498EB360"
msgid "お見事!!\nこれで【崩拳（ぽんけん）】はお主のものだ\n力を大いなる大地に委ねることが重要だぞ!!"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text

msgid "松屋前　ＤＪと龍也"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=6EFD3351
#. kurohyou:text_offset=0x2CBBA
msgctxt "kurohyou|globals|stja|hash=6EFD3351"
msgid "あや\n楽しかったよ～\n龍也！\n今日は指名してくれて\nありがとう！\n最近、男子の筋肉に\nハマってる私に龍也の筋肉は\nごちそうに見えちゃいました\n～\n今度、腹筋見せてね～\nあ、でも\nエッチな意味じゃないから！\nまた来て下さいね\n\n☆ＡＹＡ☆"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=6EFD3352
#. kurohyou:text_offset=0x2CCA8
msgctxt "kurohyou|globals|stja|hash=6EFD3352"
msgid "あや\n信じてないでしょ？\n今日もすっごい楽しかった！\n龍也、ありがとう！\n私の知られざる高校時代の\n秘密も話しちゃったし……\nでもお嬢様学校っていうの\nまだ信じてないでしょ～\nよく言われま～す！\nさて、帰って美白を\n頑張らなきゃ！\n龍也も\nゆっくり休めよ～！\n\n☆ＡＹＡ☆"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=6EFD3353
#. kurohyou:text_offset=0x2CDBA
msgctxt "kurohyou|globals|stja|hash=6EFD3353"
msgid "あや\n良くなってきたわ！\n龍也～\n今日も本当にありがと～！\n風邪気味だったから\nうつしてないか心配だけど…\n…\n龍也も気をつけてね！\nでも、龍也と話した後\nなんか元気になってきた\nもしかして名医？？\nまた元気がない時は\nお願いしますね先生！\n\n☆ＡＹＡ☆"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=6EFD3354
#. kurohyou:text_offset=0x2CEBA
msgctxt "kurohyou|globals|stja|hash=6EFD3354"
msgid "あや\n直帰します！\n今日も元気になれたわ～！\n龍也いつもありがとうね！\n今日はアフターもせずに\nまっすぐ帰るわ～\nミスイヤーの話してたら\n早く帰りたくなっちゃって\n待ってるのが男じゃなくて\n犬ってとこが\nちょい寂しいけど……\nいつかうちのミーちゃんにも\n会ってほしいな～\n楽しみにしてます！\n\n☆ＡＹＡ☆"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=6EFD3355
#. kurohyou:text_offset=0x2CFEC
msgctxt "kurohyou|globals|stja|hash=6EFD3355"
msgid "あや\n嬉しかった！\n今日もいろいろ話せたね！\n嬉しかったな～\nそれに龍也がまさかの\n年下だったなんて！\nもうテンションが\n上がりまくりだったよ！\nいつまでも素直でかわいい\n龍也でいるんだよ！\nもっともっと\n龍也のこと教えてね！\n\n☆ＡＹＡ☆"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=6EFD3356
#. kurohyou:text_offset=0x2D0DE
msgctxt "kurohyou|globals|stja|hash=6EFD3356"
msgid "あや\n元気になったよ！\n今日も来てくれてありがとう\n！\n龍也に会って寝不足も\n吹き飛んだよ！\n次の休みは漫画だけで\nつぶすのは、やめて\nせめて漫喫に行こっと\nそれじゃあ一緒か～！\n休みが合えば\n漫喫にでも行きましょう！\n\n☆ＡＹＡ☆"
msgstr ""


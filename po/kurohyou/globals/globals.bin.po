#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=02F00D41
#. kurohyou:text_offset=0x2EA96
msgctxt "kurohyou|globals|stja|hash=02F00D41"
msgid "由理香\nありがとう！\n龍也くん今日も\nありがとう！\n疲れてたけど元気になったよ\n！\nこの仕事向いてるな～って\n一人で実感しちゃってます\n龍也くんもいろいろ迷う\nだろうけど君ならきっと\n正しい決断できる！\n迷ったらいつでも\n人生の先輩に相談なさい！\n楽しみにしてるからね～\n\n由理香より"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=02F00D42
#. kurohyou:text_offset=0x2E99A
msgctxt "kurohyou|globals|stja|hash=02F00D42"
msgid "由理香\n旅館　由理香\n今日もたくさん話せたので\nテンション上がってます！\n龍也くんを癒せていたか\nわからないけど……\nまた「旅館 由理香」で\n癒しのひと時を\nお過ごしください\nあっ……\nエッチな意味じゃないからね\nまたお待ちしています～\n\n由理香より"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=02F00D43
#. kurohyou:text_offset=0x2E884
msgctxt "kurohyou|globals|stja|hash=02F00D43"
msgid "由理香\n痛い！\n今日も楽しかったね！\nいつも楽しい時間を過ごせて\n感謝です！\n龍也くんも楽しんでくれてた\nら嬉しいな\nあ、でも今日は\n少し寝不足だったから……\nゴルフの練習しすぎて\n筋肉痛がひどかったし……\nナンバーワン失格です\nこれに懲りずにまた\nお話してね！\n\n由理香より"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=02F00D44
#. kurohyou:text_offset=0x2E7C2
msgctxt "kurohyou|globals|stja|hash=02F00D44"
msgid "由理香\n連れてって！\n今日も来てくれてほんとに\nありがと～！\nご飯の話してたから\n急にお腹すいてきちゃった\n龍也くんが行くお店も\n今度連れてってほしいな！\n楽しみにしてるからね！\n\n由理香より"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=02F00D45
#. kurohyou:text_offset=0x2E6F4
msgctxt "kurohyou|globals|stja|hash=02F00D45"
msgid "由理香\n飲み過ぎた！\n龍也く～ん！\n今日も来てくれて\nありがとう！\n少しだけ酔っています\n明日泳ぐ距離は\n今日の倍になりそう……\n次来てくれた時に\n太ったって言われないように\n気をつけます！\n\n由理香より"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=02F00D46
#. kurohyou:text_offset=0x2E65A
msgctxt "kurohyou|globals|stja|hash=02F00D46"
msgid "由理香\nカラオケ！\n今日は指名してくれて\nありがとう！\nカラオケ、行けたらいいね\n龍也くんが何を歌うのか\n楽しみ\nそれまで喉に気をつけて！\n\n由理香より"
msgstr ""


msgctxt "kurohyou|globals|stja|hash=49569285"
msgid "タイトルメニューの『パスワード』で\n隠された暗号を入力すれば\n必殺技の「キッカケ」をつかめるだろう"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text

#. kurohyou:text_offset=0x2D79A
msgctxt "kurohyou|globals|stja|hash=AABA643C"
msgid "優\nてじーだよ～\nお見合いのとき\n龍也くんの名前使っちゃって\nゴメンね\n\nでも、龍也くんの名前しか\n思いつかなかったの～\n・ﾟﾟ･(≧д≦)･ﾟﾟ･\n\nどうしてだろね？\n\n今度、お礼するね！\n食べたいものあったら\nなにか考えといてね\n\nでも、私を食べたいとかは\nダメだからっ!!\n\nじゃあ、またね～\n\n♪ てじー♪"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF

#. kurohyou:text_offset=0x408EE
msgctxt "kurohyou|globals|stja|hash=498EB363"
msgid "お見事!!\nこれで【ダブルアッパーブロー】はお主のものだ\nどんなモノでも大空に吹き飛ばすがよい!!"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin

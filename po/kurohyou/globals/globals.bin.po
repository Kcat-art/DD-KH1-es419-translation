#. kurohyou:text_offset=0x31D6A
msgctxt "kurohyou|globals|stja|hash=5E349059"
msgid "投げ渡された、メッセージカードには\nドラゴンヒート３戦目の対戦相手の名が書かれていた\n『ＮＥＸＴ ＭＡＴＣＨ　Ｍ．ＹＵＫＩ』\n龍也は不安と疑いを胸に、地下格闘場のロッカールームへ向かう"
msgstr ""

#. y4:line_status=todo

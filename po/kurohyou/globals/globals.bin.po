#. kurohyou:text_offset=0x42064
msgctxt "kurohyou|globals|stja|hash=49569287"
msgid "隠された『スタイル』を習得すれば\n必殺技の「キッカケ」をつかめるだろう"
msgstr ""

#. y4:line_status=todo

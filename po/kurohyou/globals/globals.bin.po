#. kurohyou:text_offset=0x2089C
msgctxt "kurohyou|globals|stja|hash=832BDD7C"
msgid "癖がなくて、淡泊な味が通好みのネタだ\n白身魚の旨みを、心ゆくまで味わってよ"
msgstr ""


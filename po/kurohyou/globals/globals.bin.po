#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=949CD3E8
#. kurohyou:text_offset=0x2E39C
msgctxt "kurohyou|globals|stja|hash=949CD3E8"
msgid "由理香\n頼りにしてます！\n今日も本当にありがとう！\nでも、オーナーのこと\n本当に龍也くんにお願いして\nいいのかな？\n龍也くんのことも、もちろん\n心配だから\nあんまり無理はしないでね\nただ正直、頼れるのは\n龍也くんしかいないんだよね\n私にできることがあれば言っ\nてね！\n\n由理香より"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=949CD3E9
#. kurohyou:text_offset=0x2E4B6
msgctxt "kurohyou|globals|stja|hash=949CD3E9"
msgid "由理香\nちょっと頼みごとが……\nゴメン、頼まれてくれる？\nこんなこと頼めるの\n龍也くんしかいないの\nミレニアムタワーの近くで\nオーナーらしい人を見たって\n言う人がいるの黒いスーツを\n着てミレニアムタワー前の\nタクシー乗り場で誰かを\n待ってるみたいに立って\nたって\nでも今、お母さんの容態が\n急変したっていう連絡が\nあって、急いで病院に\n行かなきゃいけないの!!　\nお願い！\nオーナーを引き止めて\nおいて！\n\n由理香より"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=949CD3EA
#. kurohyou:text_offset=0x2E186
msgctxt "kurohyou|globals|stja|hash=949CD3EA"
msgid "由理香\n暗い話で…\n今日はごめんね～\n母さんの話なんて\nするつもりじゃなかったのに\n龍也くんだとついつい\n何でも話しちゃうんだよね…\n…\n今度は龍也くんのお母さんの\n話も聞かせてね\n龍也くんのこともっと知りた\nい\n今度は、お互い元気に\nなれるような話をしようね！\n\n由理香より"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=949CD3EB
#. kurohyou:text_offset=0x2E29C
msgctxt "kurohyou|globals|stja|hash=949CD3EB"
msgid "由理香\n癒された！\n今日も癒されました！\nありがと～\n最近は龍也くんに\n話を聞いてもらって\n私が癒されるパターンだね\n龍也くん聞き上手だから\n私、ついつい喋っちゃうの\n今度は私が悩み相談に乗るか\nら\nお姉さんが何でも解決して\nあげるからね！\n\n由理香より"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=949CD3EC
#. kurohyou:text_offset=0x2DFAC
msgctxt "kurohyou|globals|stja|hash=949CD3EC"
msgid "由理香\nまたいつでも！\n今日は来てくれてありがとう\n！\n楽しい話たくさんできて\n嬉しかったです\nもし株で勝負したくなったら\nいつでも言ってね\nでは夜更かししすぎないで\n早く寝なさいよ～\n\n\n由理香より"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=949CD3ED
#. kurohyou:text_offset=0x2E076
msgctxt "kurohyou|globals|stja|hash=949CD3ED"
msgid "由理香\nごめんね！\n今日はありがとうね！\n龍也くんとすご～く\n打ち解けた気がして\n嬉しかったです\nそうだ！\nせっかく誘ってくれたのに\n予定合わなくてごめんなさい\n今度ゴルフ教えてあげるから\n一緒に回ろうね\nまたお店でも楽しい会話\nできるの楽しみにしてるね\n\n\n由理香より"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=system_text
#. kurohyou:container=globals.bin
#. kurohyou:elpk_resource=EC992FCF
#. kurohyou:stja_version=0x09111100
#. kurohyou:stja_hash=949CD3EF
#. kurohyou:text_offset=0x2DED0
msgctxt "kurohyou|globals|stja|hash=949CD3EF"
msgid "由理香\n話せて嬉しかった\n今日は指名してくれて\nありがとう\n龍也くんのことは前から\n知ってたけど\nちゃんと話したのは\n初めてだったね\nまた来てくれたら嬉しいな\nそれではくれぐれも\n風邪などひかないように！\n\n由理香より"
msgstr ""


#. kurohyou:default_color_rgb=#FFFFFF
#. kurohyou:default_color_raw=0x00FFFFFF
#. kurohyou:message_se=0x98CC1658
msgctxt "kurohyou|city|city_sequence.pack|elpk=4FF6AB2E|cmd=0050|off=4B0"
msgid "そして、<KSEQ_ADVANCE_NEXT>神室町で水商売を始め……\nなんとかＪｅｗｅＬを持つことができた"
msgstr "Luego comencé en el negocio nocturno en Kamurocho...\ny logré, de alguna manera, tener Jew eL."


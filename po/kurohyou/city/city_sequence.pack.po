#. kurohyou:default_color_raw=0x00FFFFFF
#. kurohyou:message_se=0x98CC1658
msgctxt "kurohyou|city|city_sequence.pack|elpk=4FF6AB2E|cmd=0052|off=4C8"
msgid "ひと目でわかったよ\n由理香が私の娘だってことは……"
msgstr "Lo supe de inmediato:\nque Yurika era mi hija..."

#. y4:line_status=translated
#. y4:translated_by=Kcat0

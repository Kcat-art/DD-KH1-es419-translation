#. kurohyou:default_color_rgb=#FFFFFF
#. kurohyou:default_color_raw=0x00FFFFFF
#. kurohyou:message_se=0x98CC1658
msgctxt "kurohyou|city|city_sequence.pack|elpk=4FF6AB2E|cmd=0054|off=4E0"
msgid "だから私は、<KSEQ_ADVANCE_NEXT>店のオーナーとして\n一人のホステスとして彼女に接した"
msgstr "Por eso, como propietario,\nla traté simplemente como a otra host."


#. kurohyou:message_se=0x98CC165C
msgctxt "kurohyou|city|city_sequence.pack|elpk=80B81D7D|cmd=0038|off=3B8"
msgid "じゃ、<KSEQ_ADVANCE_NEXT>今、<KSEQ_ADVANCE_NEXT><KSEQ_COLOR:FF8050>児童公園<KSEQ_RESET>に行けば\n黒田の野郎に会えるんだな"
msgstr "Entonces, si voy ahora al <KSEQ_COLOR:FF8050>Parque Infantil<KSEQ_RESET>,\npodré ver a ese bastardo de Kuroda, ¿no?"


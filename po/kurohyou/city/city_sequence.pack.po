#. kurohyou:message_se=0x98CC165C
msgctxt "kurohyou|city|city_sequence.pack|elpk=80B81D7D|cmd=0040|off=3D0"
msgid "関係ねぇだろが！\nどうなんだよ!?　黒田はいるのか!?"
msgstr "¡No te importa!\n¿Qué pasa, eh? ¿Está Kuroda ahí o no?"

#. y4:line_status=translated
#. y4:translated_by=Kcat0

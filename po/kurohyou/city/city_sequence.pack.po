msgid "な、<KSEQ_ADVANCE_NEXT>何でオレらが<KSEQ_COLOR:FF8050>児童公園<KSEQ_RESET>に\n集まること知ってんだよ!"
msgstr "¿C-cómo sabes que nos reunimos\nen el <KSEQ_COLOR:FF8050>Parque Infantil<KSEQ_RESET>?"


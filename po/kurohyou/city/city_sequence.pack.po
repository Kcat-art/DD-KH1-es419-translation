#. kurohyou:default_color_rgb=#FFFFFF
#. kurohyou:default_color_raw=0x00FFFFFF
#. kurohyou:message_se=0x98CC1658
msgctxt "kurohyou|city|city_sequence.pack|elpk=AC40C0AE|cmd=0149|off=9EC"
msgid "クズを排除して、<KSEQ_ADVANCE_NEXT>よりよい学校を作ること\nそれが……生徒会長としての使命なんだ"
msgstr "Eliminar a la escoria y crear una mejor escuela.\nEsa es... mi misión como presidente del consejo."

